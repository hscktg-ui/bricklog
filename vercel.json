{
  "regions": ["icn1"],
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.briclog.ai" }],
      "destination": "https://briclog.ai/:path*",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/brand/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/favicon.svg",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/apple-touch-icon.svg",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/og.png",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    }
  ],
  "functions": {
    "app/api/public/brand-test/route.js": {
      "maxDuration": 120,
      "memory": 1024
    },
    "app/api/cron/nightly-evolution/route.js": {
      "maxDuration": 300,
      "memory": 1024
    },
    "app/api/cron/daily-develop/route.js": {
      "maxDuration": 120,
      "memory": 1024
    },
    "app/api/trends/collect/route.js": {
      "maxDuration": 60,
      "memory": 1024
    }
  },
  "crons": [
    {
      "path": "/api/trends/collect",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/daily-develop",
      "schedule": "0 15 * * *"
    },
    {
      "path": "/api/cron/daily-digest",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/nightly-evolution",
      "schedule": "30 16 * * *"
    }
  ]
}
